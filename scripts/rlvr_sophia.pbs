#!/bin/bash
#PBS -N ascii-rlvr
#PBS -A EVITA
#PBS -q single-gpu
#PBS -l select=1
#PBS -l walltime=03:00:00
#PBS -l filesystems=home:grand
#PBS -o /grand/EVITA/eric-spencer/ascii-llm-training/logs/rlvr.out
#PBS -e /grand/EVITA/eric-spencer/ascii-llm-training/logs/rlvr.err

# P2/P3 acceptance run: the P2 decoding check (format pass-rate with and
# without constrained decoding) followed by a GRPO run against the
# asciiart.verify reward. The GRPO step ends with a paired held-out eval,
# base vs trained adapter on the same tasks with the same decoding -- that
# paired number is the only base-vs-trained result this job produces.
set -e
cd /grand/EVITA/eric-spencer/ascii-llm-training
mkdir -p logs rlvr/logs rlvr/checkpoints

export HF_HOME=/grand/EVITA/eric-spencer/hf-cache
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export PIP_CACHE_DIR=/grand/EVITA/eric-spencer/.pipcache
# rlvr/_te_stub comes first so it shadows the system-site-packages
# `transformer_engine` that crashes `import peft` on this system (broken
# libtransformer_engine.so vs. the loaded libcublasLt) -- see
# rlvr/_te_stub/transformer_engine.py for the full explanation.
export PYTHONPATH=rlvr/_te_stub:.

PY=/grand/EVITA/eric-spencer/venvs/sophia-train/bin/python
MODEL=Qwen/Qwen2.5-0.5B-Instruct
COLS=24
ROWS=12

echo "== Ensuring pyfiglet/pillow present =="
$PY -m pip install --quiet pyfiglet pillow || true

echo "== P2 decoding check: constrained vs unconstrained =="
$PY -m rlvr.train_grpo --eval-only --eval-mode decoding --model "$MODEL" \
    --cols $COLS --rows $ROWS --n-tasks 20 --device cuda

echo "== GRPO run, ends with a paired held-out eval =="
$PY -m rlvr.train_grpo --model "$MODEL" --cols $COLS --rows $ROWS \
    --steps 600 --num-generations 8 --n-tasks 40 --device cuda

echo "== Done =="
